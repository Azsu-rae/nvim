
set textwidth=90
set wildignorecase
set path+=**

set laststatus=3
set splitbelow
set nocursorline
set nowrap

set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

set number
set relativenumber
set signcolumn=yes

set hlsearch
set smartcase
set ignorecase
set incsearch

set belloff=all
set termguicolors

let mapleader = " "

tnoremap <ESC><ESC> <C-\><C-n>

nnoremap <S-ScrollWheelUp> 3zh
nnoremap <S-ScrollWheelDown> 3zl
